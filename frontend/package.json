{
  "name": "moneylog",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:mock": "ng serve --configuration mock",
    "start:demo": "ng serve --configuration demo --port 4210",
    "start:local": "node scripts/start-local.mjs",
    "build": "ng build",
    "build:production-mock": "ng build --configuration production-mock",
    "postbuild": "node scripts/check-chart-budget.mjs",
    "postbuild:production-mock": "node scripts/check-chart-budget.mjs",
    "check:chart-budget": "node scripts/check-chart-budget.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false --coverage",
    "test:watch": "ng test",
    "e2e": "playwright test",
    "e2e:integration": "E2E_INTEGRATION=1 playwright test --project=integration",
    "lint": "ng lint && node scripts/check-styles.mjs && node scripts/check-brand.mjs && node scripts/check-native-controls.mjs && node --test scripts/check-native-controls.test.mjs && node scripts/check-contrast.mjs --quiet",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs",
    "typecheck": "ngc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "api:types": "openapi-typescript ../contracts/openapi.yaml -o src/util/api/schema.gen.ts",
    "api:check": "node scripts/check-api-types.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "contrast": "node scripts/check-contrast.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "prepare": "cd .. && husky frontend/.husky"
  },
  "dependencies": {
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/router": "22.2.1",
    "@angular/service-worker": "22.2.1",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "marked": "18.1.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.1",
    "@angular/cli": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@resvg/resvg-js": "2.6.2",
    "@testing-library/angular": "19.5.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.7",
    "@vitest/coverage-v8": "5.0.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "angular-eslint": "22.5.0",
    "axe-core": "4.13.0",
    "dependency-cruiser": "18.5.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "husky": "9.1.7",
    "jsdom": "30.1.1",
    "lint-staged": "17.6.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
