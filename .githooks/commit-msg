#!/usr/bin/env bash
msg="$(grep -v "^#" "$1")"
first="$(printf "%s" "$msg" | head -1)"
if ! printf "%s" "$first" | grep -Eq "^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?: .+"; then
  echo "commit recusado: use Conventional Commits (tipo(escopo): descrição no imperativo, minúscula)." >&2; exit 1
fi
