#!/bin/bash
# Prepara a instância (executado uma vez pelo cloud-init). Nenhum segredo aqui: a configuração vem do SSM no momento do deploy.
# Modo do banco: ${database_mode} | borda: ${edge_mode}
set -euo pipefail
dnf install -y docker
systemctl enable --now docker

# Plugin do Docker Compose (não vem no repositório do Amazon Linux). Versão fixa + conferência do SHA-256 publicado na release.
COMPOSE_VERSION="v2.29.7"
case "$(uname -m)" in aarch64) CARCH=aarch64 ;; *) CARCH=x86_64 ;; esac
mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL "https://github.com/docker/compose/releases/download/$COMPOSE_VERSION/docker-compose-linux-$CARCH" -o /tmp/docker-compose
curl -fsSL "https://github.com/docker/compose/releases/download/$COMPOSE_VERSION/docker-compose-linux-$CARCH.sha256" -o /tmp/docker-compose.sha256
(cd /tmp && echo "$(cut -d' ' -f1 /tmp/docker-compose.sha256)  docker-compose" | sha256sum -c -)
install -m 0755 /tmp/docker-compose /usr/local/lib/docker/cli-plugins/docker-compose
rm -f /tmp/docker-compose /tmp/docker-compose.sha256

%{ if database_mode == "ec2" ~}
# Instância de 1 GB roda Spring Boot + Postgres: 1 GB de swap evita o OOM killer em picos (migração, backup).
if [ ! -f /swapfile ]; then
  dd if=/dev/zero of=/swapfile bs=1M count=1024
  chmod 600 /swapfile
  mkswap /swapfile
  echo "/swapfile none swap sw 0 0" >> /etc/fstab
fi
swapon -a
%{ endif ~}

mkdir -p /opt/moneylog/backups
chown 10001:10001 /opt/moneylog/backups
%{ if database_mode == "ec2" ~}

# Volume de dados do Postgres (EBS separado do disco do sistema; sobrevive à troca da instância).
DEV="/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_${data_volume_id}"
for _ in $(seq 1 60); do [ -e "$DEV" ] && break; sleep 5; done
[ -e "$DEV" ] || { echo "volume de dados não apareceu: $DEV" >&2; exit 1; }
blkid "$DEV" >/dev/null 2>&1 || mkfs.xfs -L moneylogdata "$DEV"
mkdir -p /opt/moneylog/pgdata
grep -q moneylogdata /etc/fstab || echo "LABEL=moneylogdata /opt/moneylog/pgdata xfs defaults,nofail 0 2" >> /etc/fstab
mount -a
chown 999:999 /opt/moneylog/pgdata
%{ endif ~}

%{ if edge_mode == "cloudflare" ~}
# ---- Borda Cloudflare: Caddy na 443 (Origin Certificate vindo do SSM no deploy), front em /srv/app, sem nenhum segredo aqui ----
dnf install -y unzip
mkdir -p /opt/moneylog/certs /opt/moneylog/edge /srv/app/releases
chmod 700 /opt/moneylog/certs

cat > /opt/moneylog/Caddyfile <<'CADDY'
${caddyfile}
CADDY

%{ if authenticated_origins ~}
# Authenticated Origin Pulls: o CA público da Cloudflare valida o certificado de cliente que ela apresenta.
curl -fsSL https://developers.cloudflare.com/ssl/static/authenticated_origin_pull_ca.pem -o /opt/moneylog/edge/aop-ca.pem
cat > /opt/moneylog/aop.caddy <<'AOP'
client_auth {
	mode require_and_verify
	trust_pool file /etc/caddy/aop-ca.pem
}
AOP
%{ else ~}
echo "# Authenticated Origin Pulls desligado" > /opt/moneylog/aop.caddy
%{ endif ~}
%{ if csp != "" ~}
cat > /opt/moneylog/csp.caddy <<'CSP'
header Content-Security-Policy "${csp}"
CSP
%{ else ~}
echo "# CSP desligada" > /opt/moneylog/csp.caddy
%{ endif ~}

# Valores não secretos lidos pelo deploy.sh (viram MONEYLOG_ALLOWED_ORIGINS e MONEYLOG_TRUSTED_PROXIES do backend).
# O backend vê o IP do container do Caddy (rede 172.29.0.0/24 do compose) e confia no X-Forwarded-For que ele monta.
printf '%s' "https://${domain_name}" > /opt/moneylog/edge/allowed-origins
printf '%s' "$(echo "${cloudflare_cidrs}" | tr ' ' ',')" > /opt/moneylog/edge/cloudflare-cidrs
printf '%s,%s' "172.29.0.0/24" "$(cat /opt/moneylog/edge/cloudflare-cidrs)" > /opt/moneylog/edge/trusted-proxies
printf 'CF_PROXIES=%s\n' "${cloudflare_cidrs}" > /opt/moneylog/edge/caddy.env
%{ endif ~}

cat > /opt/moneylog/docker-compose.yml <<'COMPOSE'
# Gerado pelo user_data (Terraform). A imagem vem de IMAGE (/opt/moneylog/.env, escrito por deploy.sh); nada secreto aqui:
# os segredos ficam em /opt/moneylog/secrets (um arquivo por variável, vindo do SSM) e são lidos como Docker secrets.
name: moneylog
services:
%{ if database_mode == "ec2" ~}
  postgres:
    image: postgres:17
    restart: unless-stopped
    environment:
      POSTGRES_DB: ${db_name}
      POSTGRES_USER_FILE: /run/secrets/DB_USER
      POSTGRES_PASSWORD_FILE: /run/secrets/DB_PASSWORD
    volumes:
      - /opt/moneylog/pgdata:/var/lib/postgresql/data
      - /opt/moneylog/secrets:/run/secrets:ro
    # Sem "ports": o Postgres só é alcançável pela rede interna do compose.
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${db_username} -d ${db_name}"]
      interval: 5s
      timeout: 5s
      retries: 10
      start_period: 10s
%{ endif ~}
  backend:
    image: $${IMAGE:?IMAGE não definida (use /opt/moneylog/deploy.sh <tag>)}
    restart: unless-stopped
%{ if database_mode == "ec2" ~}
    depends_on:
      postgres:
        condition: service_healthy
%{ endif ~}
%{ if database_mode == "ec2" ~}
    # Teto de memória do container: a JVM calcula o heap (75%) em cima disto e deixa espaço para o Postgres na mesma máquina.
    mem_limit: 640m
%{ endif ~}
    environment:
      SPRING_PROFILES_ACTIVE: prod
    ports:
%{ if edge_mode == "cloudflare" ~}
      # Só no loopback (health check do deploy.sh). O Caddy fala com o backend pela rede interna do compose.
      - "127.0.0.1:8080:8080"
%{ else ~}
      - "8080:8080"
%{ endif ~}
    volumes:
      - /opt/moneylog/secrets:/run/secrets:ro
      - /opt/moneylog/backups:/var/backups/moneylog
    read_only: true
    tmpfs:
      - /tmp
    logging:
      driver: awslogs
      options:
        awslogs-region: ${region}
        awslogs-group: ${log_group}
        awslogs-stream: backend
%{ if edge_mode == "cloudflare" ~}
  caddy:
    image: caddy:2
    restart: unless-stopped
    depends_on:
      - backend
    ports:
      - "443:443"
%{ if allow_http ~}
      - "80:80"
%{ endif ~}
    env_file:
      - /opt/moneylog/edge/caddy.env
    environment:
      DOMAIN: ${domain_name}
    volumes:
      - /opt/moneylog/Caddyfile:/etc/caddy/Caddyfile:ro
      - /opt/moneylog/aop.caddy:/etc/caddy/aop.caddy:ro
      - /opt/moneylog/csp.caddy:/etc/caddy/csp.caddy:ro
%{ if authenticated_origins ~}
      - /opt/moneylog/edge/aop-ca.pem:/etc/caddy/aop-ca.pem:ro
%{ endif ~}
      - /opt/moneylog/certs:/certs:ro
      - /srv/app:/srv/app:ro
      - caddy_data:/data
      - caddy_config:/config

volumes:
  caddy_data:
  caddy_config:

networks:
  default:
    ipam:
      config:
        - subnet: 172.29.0.0/24
%{ endif ~}
COMPOSE

cat > /opt/moneylog/deploy.sh <<'DEPLOY'
#!/bin/bash
# Uso: /opt/moneylog/deploy.sh <tag-da-imagem>   |   /opt/moneylog/deploy.sh --rollback
# Baixa a configuração do SSM para arquivos (um por variável, com o NOME da variável), sobe o compose e espera o health.
# Se o health não vier, volta sozinho para a tag anterior. Os valores nunca vão para a linha de comando nem para o log.
set -euo pipefail
REGION="${region}"
REGISTRY="${registry}"
REPOSITORY="${repository}"
DIR=/opt/moneylog
SECRETS=$DIR/secrets
cd "$DIR"

CURRENT=""; [ -f current-tag ] && CURRENT="$(cat current-tag)"
if [ "$${1:-}" = "--rollback" ]; then
  [ -f previous-tag ] || { echo "sem tag anterior registrada" >&2; exit 1; }
  TAG="$(cat previous-tag)"
else
  TAG="$${1:?informe a tag da imagem (ou --rollback)}"
fi

wait_healthy() {
  for _ in $(seq 1 36); do
    if curl -fsS http://127.0.0.1:8080/actuator/health 2>/dev/null | grep -q '"UP"'; then return 0; fi
    sleep 5
  done
  return 1
}

start_with() {
  printf 'IMAGE=%s/%s:%s\n' "$REGISTRY" "$REPOSITORY" "$1" > "$DIR/.env"
  docker compose up -d --remove-orphans
%{ if edge_mode == "cloudflare" ~}
  # Recarrega o Caddy (pega certificado novo sem derrubar conexões).
  docker compose exec -T caddy caddy reload --config /etc/caddy/Caddyfile --force >/dev/null 2>&1 || true
%{ endif ~}
}

# Configuração do SSM -> arquivos legíveis só pelo usuário do container (uid 10001) e por root (Postgres lê como root).
umask 077
mkdir -p "$SECRETS"
find "$SECRETS" -type f -delete
aws ssm get-parameters-by-path --region "$REGION" --path "${ssm_prefix}" --with-decryption --query 'Parameters[].[Name,Value]' --output text |
  while IFS=$'\t' read -r name value; do
    printf '%s' "$value" > "$SECRETS/$(basename "$name")"
  done
%{ if edge_mode == "cloudflare" ~}
# Valores do Terraform (não secretos) têm prioridade sobre qualquer parâmetro SSM de mesmo nome.
tr -d '\n' < "$DIR/edge/allowed-origins" > "$SECRETS/MONEYLOG_ALLOWED_ORIGINS"
tr -d '\n' < "$DIR/edge/trusted-proxies" > "$SECRETS/MONEYLOG_TRUSTED_PROXIES"

# Origin Certificate da Cloudflare: SSM SecureString -> /opt/moneylog/certs (root, 600). Nunca passa pelo Terraform.
mkdir -p "$DIR/certs"
chmod 700 "$DIR/certs"
fetch_cert() { # <parâmetro> <arquivo> <cabeçalho PEM esperado>
  local tmp
  tmp="$(mktemp "$DIR/certs/.tmp.XXXXXX")"
  aws ssm get-parameter --region "$REGION" --with-decryption --name "${ssm_prefix}/edge/$1" \
    --query Parameter.Value --output text > "$tmp" || { rm -f "$tmp"; echo "parâmetro ${ssm_prefix}/edge/$1 não encontrado (veja o guia: carregar o Origin Certificate)" >&2; exit 1; }
  grep -q "^-----BEGIN $3" "$tmp" || { rm -f "$tmp"; echo "${ssm_prefix}/edge/$1 não parece um PEM ($3)" >&2; exit 1; }
  chmod 600 "$tmp"
  mv "$tmp" "$DIR/certs/$2"
}
fetch_cert origin-pem origin.pem "CERTIFICATE"
fetch_cert origin-key origin.key "[A-Z ]*PRIVATE KEY"
%{ endif ~}
chown -R 10001:10001 "$SECRETS"
chmod 500 "$SECRETS"
chmod 400 "$SECRETS"/*

aws ecr get-login-password --region "$REGION" | docker login --username AWS --password-stdin "$REGISTRY" >/dev/null
docker pull "$REGISTRY/$REPOSITORY:$TAG"

start_with "$TAG"
if wait_healthy; then
  if [ "$TAG" != "$CURRENT" ]; then
    [ -n "$CURRENT" ] && echo "$CURRENT" > previous-tag
    echo "$TAG" > current-tag
  fi
  echo "deploy ok: $TAG"
  exit 0
fi

echo "health não ficou UP com $TAG" >&2
docker compose logs --tail 30 backend >&2 || true
if [ -n "$CURRENT" ] && [ "$CURRENT" != "$TAG" ]; then
  echo "voltando para $CURRENT" >&2
  start_with "$CURRENT"
  wait_healthy && echo "rollback ok: $CURRENT" >&2 || echo "rollback também não ficou UP" >&2
fi
exit 1
DEPLOY
chmod 755 /opt/moneylog/deploy.sh
%{ if edge_mode == "cloudflare" ~}

printf 'REGION=%s\nBUCKET=%s\nDOMAIN=%s\n' "${region}" "${artifacts_bucket}" "${domain_name}" > /opt/moneylog/edge/front.env
cat > /opt/moneylog/deploy-frontend.sh <<'FRONT'
${front_script}
FRONT
chmod 755 /opt/moneylog/deploy-frontend.sh

cat > /opt/moneylog/edge-refresh.sh <<'EDGE'
#!/bin/bash
# Atualiza na instância os CIDRs da Cloudflare (Caddy + MONEYLOG_TRUSTED_PROXIES). O Security Group é atualizado pelo
# `terraform apply` (prefix lists). Uso (root): /opt/moneylog/edge-refresh.sh
set -euo pipefail
cd /opt/moneylog
V4="$(curl -fsS https://www.cloudflare.com/ips-v4)"
V6="$(curl -fsS https://www.cloudflare.com/ips-v6)"
ALL="$(printf '%s\n%s\n' "$V4" "$V6" | tr -d '\r' | grep -E '^[0-9a-fA-F:.]+/[0-9]+$' || true)"
[ "$(echo "$ALL" | grep -c .)" -ge 10 ] || { echo "lista da Cloudflare suspeita; nada foi alterado" >&2; exit 1; }
printf 'CF_PROXIES=%s\n' "$(echo "$ALL" | paste -sd' ' -)" > edge/caddy.env
printf '%s' "$(echo "$ALL" | paste -sd',' -)" > edge/cloudflare-cidrs
printf '%s,%s' "172.29.0.0/24" "$(cat edge/cloudflare-cidrs)" > edge/trusted-proxies
docker compose up -d --force-recreate caddy
[ -f current-tag ] && ./deploy.sh "$(cat current-tag)"
EDGE
chmod 755 /opt/moneylog/edge-refresh.sh
%{ endif ~}
